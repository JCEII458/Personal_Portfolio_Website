# ---------------------------------------------------------------
# Copy this file to `.env.local` for local development, and add the
# same variables in your hosting dashboard (e.g. Vercel → Project →
# Settings → Environment Variables). Never commit real secrets.
# ---------------------------------------------------------------

# Public production URL (used for canonical URLs, sitemap, Open Graph).
# Example: https://www.joelescareal.com
NEXT_PUBLIC_SITE_URL=

# --- Contact form delivery (Resend — https://resend.com) ----------
# When these three values are set, the contact form sends inquiries by
# email. When any of them is missing, the form shows a setup notice and
# does NOT pretend that messages were delivered.
RESEND_API_KEY=
# Inbox that should receive inquiries.
CONTACT_TO_EMAIL=
# Verified sender in Resend, e.g. "Portfolio Inquiries <inquiries@yourdomain.com>"
CONTACT_FROM_EMAIL=
